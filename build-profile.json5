{
  "app": {
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          // Fill these values with your local Harmony signing materials before building.
          "certpath": "/path/to/your-debug.cer",
          "keyAlias": "debugKey",
          "keyPassword": "YOUR_KEY_PASSWORD",
          "profile": "/path/to/your-debug.p7b",
          "signAlg": "SHA256withECDSA",
          "storeFile": "/path/to/your-debug.p12",
          "storePassword": "YOUR_STORE_PASSWORD"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "compatibleSdkVersion": "6.0.0(20)",
        "targetSdkVersion": "6.0.0(20)",
        "runtimeOS": "HarmonyOS"
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
